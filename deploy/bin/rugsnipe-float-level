#!/bin/bash
# rugsnipe-float-level: bring the long copy's floats back to their sizes, by itself (2026-11-15: a float that lost
# twice bought smaller copies until the owner's daily `float level`; one that won sat above its size).
# Reads /etc/rugsnipe/float-levels, one "MINT SOL" a line (# = comment), and runs `rugsnipe-long float level MINT SOL`
# for each (it buys what is missing or sells the excess through Jupiter, and does nothing within 5% of the size).
# Only while no copy is open: a float with a copy out looks short, and levelling it then would buy what the sale
# brings back a minute later. Started every 10 minutes by rugsnipe-float-level.timer; by hand:
#   sudo rugsnipe-float-level [CONFIG] [LEVELS]
set -u
B=${RUGSNIPE_LONG:-/opt/rugsnipe/bin/rugsnipe-long}; C=${1:-/etc/rugsnipe/long.toml}; L=${2:-/etc/rugsnipe/float-levels}
[ -r "$L" ] || { echo "float-level: no $L, nothing done"; exit 0; }
# copies open now, over the book's lines ("...; N open; ..."); empty when the status cannot be read
open_now() { "$B" status --config "$C" 2>/dev/null | sed -n 's/.*; \([0-9][0-9]*\) open;.*/\1/p' | awk '{s += $1} END {if (NR) print s}'; }
while read -r mint sol _; do
  case "$mint" in ''|\#*) continue ;; esac
  n=$(open_now)
  if [ "$n" != "0" ]; then echo "float-level: ${n:-?} open, stopping (the next run goes on)"; exit 0; fi
  out=$("$B" float level "$mint" "$sol" --config "$C" 2>&1 | sed -E 's#https?://[^ "]*#<url>#g')
  # one line a float in the journal: what it did, or why not
  echo "float-level: ${mint:0:8} to $sol SOL: $(echo "$out" | tr '\n' ' ' | cut -c1-300)"
  sleep 5
done < "$L"
