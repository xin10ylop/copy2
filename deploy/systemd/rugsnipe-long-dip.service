# rugsnipe-long-dip -- hot role. The DIP unit (Nov 19): wallet 4's buys bought on a 10% dip after them, from a NEW
# wallet of its own (/etc/rugsnipe/keys/dip-wallet.json), with /etc/rugsnipe/long-dip.toml and its own state
# (/var/lib/rugsnipe-long-dip). `rugsnipe-long status --config /etc/rugsnipe/long-dip.toml` shows its book.
[Unit]
Description=rugsnipe long DIP unit (wallet 4's buys bought on the dip, its own wallet)
Documentation=file:/opt/rugsnipe/src/docs/20-long-copy.md
PartOf=rugsnipe.target
Wants=network-online.target
After=network-online.target time-sync.target chrony.service
ConditionPathExists=/etc/rugsnipe/long-dip.toml
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
User=rugsnipe
Group=rugsnipe
StateDirectory=rugsnipe-long-dip
StateDirectoryMode=0750
WorkingDirectory=/var/lib/rugsnipe-long-dip
Environment=RUST_BACKTRACE=1
ExecStart=/opt/rugsnipe/bin/rugsnipe-long run --config /etc/rugsnipe/long-dip.toml
Restart=always
RestartSec=2
TimeoutStopSec=10
UMask=0027
LimitNOFILE=65536
# Credentials: copied by PID 1 from /etc/rugsnipe/keys into $CREDENTIALS_DIRECTORY (the service
# user never reads /etc/rugsnipe/keys); ABSENT is the fallback when a file is missing.
LoadCredential=api-keys:/etc/rugsnipe/keys/api-keys.toml
SetCredential=api-keys:ABSENT
# its OWN wallet (the owner, Nov 19: "a whole new wallet, as if another person is doing it")
LoadCredential=long-wallet:/etc/rugsnipe/keys/dip-wallet.json
SetCredential=long-wallet:ABSENT
# hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
ReadWritePaths=/var/lib/rugsnipe-long-dip

[Install]
WantedBy=rugsnipe.target
